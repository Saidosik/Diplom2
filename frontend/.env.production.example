NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://YOUR_VPS_IP

# Server-only URL used by Next.js BFF routes inside Docker network.
# Do not use a public Laravel URL here.
LARAVEL_API_URL=http://backend:8000/api

# Reverb should be reached through the same HTTPS origin/reverse proxy, not a public 8080 port.
NEXT_PUBLIC_REVERB_APP_KEY=local-app-key
NEXT_PUBLIC_REVERB_HOST=YOUR_VPS_IP
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_FORCE_TLS=true
