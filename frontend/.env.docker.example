# Frontend container runtime settings.
# Browser traffic reaches only Next.js on http://localhost:3000.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only URL used by Next.js BFF routes inside the Docker network.
# Do not expose Laravel directly to the browser.
LARAVEL_API_URL=http://backend:8000/api


# Realtime note: this compose file does not publish Reverb directly.
# For browser websockets in production, route websocket traffic through the public reverse proxy.
NEXT_PUBLIC_REVERB_APP_KEY=local-app-key
# NEXT_PUBLIC_REVERB_HOST=localhost
# NEXT_PUBLIC_REVERB_PORT=443
# NEXT_PUBLIC_REVERB_FORCE_TLS=true
