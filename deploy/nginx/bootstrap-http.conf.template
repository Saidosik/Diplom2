server {
    listen 80;
    listen [::]:80;
    server_name ${VPS_PUBLIC_IP};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 200 'ACME bootstrap for ${VPS_PUBLIC_IP}\n';
        add_header Content-Type text/plain;
    }
}
