# Generated from the current project configs and uploaded .env
# Do not commit real secrets. Use .env.example for Git.

# APP
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# LOGGING
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME=Laravel Log
LOG_SLACK_EMOJI=:boom:
LOG_STDERR_FORMATTER=
LOG_SYSLOG_FACILITY=LOG_USER

# DATABASE
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=diplom
DB_USERNAME=postgres
DB_PASSWORD=
DB_URL=
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci
DB_FOREIGN_KEYS=true
DB_SSLMODE=prefer
DB_TRUST_SERVER_CERTIFICATE=false

# SESSION / CACHE / QUEUE
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PARTITIONED_COOKIE=false
CACHE_STORE=database
CACHE_PREFIX=
DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=
DB_CACHE_LOCK_TABLE=
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

# REDIS / MEMCACHED
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_USERNAME=
REDIS_URL=
REDIS_QUEUE=default
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_CACHE_CONNECTION=default
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PERSISTENT_ID=

# AUTH / JWT / SANCTUM
AUTH_GUARD=api
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_REFRESH_IAT=false
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0
JWT_SHOW_BLACKLIST_EXCEPTION=true
JWT_LEEWAY=0
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PASSPHRASE=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_TOKEN_PREFIX=

# FILESYSTEM / AWS
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MAIL
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_SCHEME=
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_URL=
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=
RESEND_API_KEY=

# BROADCASTING / REVERB
BROADCAST_CONNECTION=reverb
REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=local-app
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_MESSAGE_SIZE=10000
REVERB_MAX_REQUEST_SIZE=10000
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REVERB_PULSE_INGEST_INTERVAL=15
REVERB_TELESCOPE_INGEST_INTERVAL=15

# OAUTH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/oauth/yandex/callback

# AI / OPENROUTER — бесплатные модели чата + бесплатные embeddings
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY="${OPENROUTER_API_KEY}"
AI_BASE_URL="${OPENROUTER_BASE_URL}"

# Бесплатные модели для чата
# Основная модель по умолчанию
AI_CHAT_MODEL=deepseek/deepseek-v4-flash:free
AI_CHAT_MODEL_LABEL="DeepSeek V4 Flash Free"

# Универсальная модель для обычного чата и документов
AI_ALT_MODEL=google/gemma-4-31b-it:free
AI_ALT_MODEL_LABEL="Google Gemma 4 31B Free"

# Модель для кодинга, ревью, дебага и рефакторинга
AI_CODE_MODEL=poolside/laguna-m.1:free
AI_CODE_MODEL_LABEL="Poolside Laguna M.1 Free"

# Модель для длинного контекста, файлов, UI/UX и сложных задач
AI_LONG_CONTEXT_MODEL=moonshotai/kimi-k2.6:free
AI_LONG_CONTEXT_MODEL_LABEL="MoonshotAI Kimi K2.6 Free"

# Бесплатная модель для embeddings/RAG
AI_EMBEDDING_PROVIDER=openrouter
AI_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
AI_EMBEDDING_MODEL_LABEL="NVIDIA Llama Nemotron Embed VL 1B V2 Free"
AI_EMBEDDING_DIMENSIONS=2048
AI_EMBEDDINGS_CACHE=true
AI_EMBEDDINGS_LOCAL_FALLBACK=true
AI_AUTO_REEMBED=true
AI_INDEX_QUEUE=ai-index

# RAG / генерация
AI_AUTO_ANSWER_QUESTIONS=true
AI_RAG_MAX_SOURCES=8
AI_RAG_MIN_SIMILARITY=0.35
AI_RAG_RERANK=false
AI_RAG_LOCAL_FALLBACK=true
AI_RERANK_ENABLED=false
AI_RERANK_PROVIDER=
AI_RERANK_MODEL=
AI_VECTOR_DRIVER=pgvector
AI_VECTOR_COLUMN=embedding_vector
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1600
AI_TIMEOUT=40
AI_ATTACHMENTS_DISK=local
AI_ATTACHMENTS_MAX_KB=1024
AI_ATTACHMENTS_MAX_EXTRACTED_CHARS=24000
# CODE RUNNER / UPLOAD LIMITS
CODE_RUNNER_TIME_LIMIT_MS=1500
CODE_RUNNER_MEMORY_LIMIT_MB=128
CODE_RUNNER_STOP_ON_FIRST_FAILED_TEST=false
CODE_RUNNER_DOCKER_CPUS=0.5
CODE_RUNNER_DOCKER_PIDS_LIMIT=64
CODE_RUNNER_DOCKER_TMPFS_SIZE=512m
CODE_RUNNER_JS_IMAGE=node:22-alpine
CODE_RUNNER_PYTHON_IMAGE=python:3.13-alpine
CODE_RUNNER_PHP_IMAGE=php:8.3-cli-alpine
CODE_RUNNER_CPP_IMAGE=gcc:14
CODE_RUNNER_CSHARP_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0-alpine
CHAT_MAX_FILES=5
CHAT_MAX_FILE_KB=10240
USER_FILE_MAX_FILE_KB=20480
AVATAR_MAX_FILE_KB=2048
PLAYGROUND_MAX_CODE_CHARS=30000
PLAYGROUND_MAX_STDIN_CHARS=8000
PLAYGROUND_MAX_OUTPUT_CHARS=20000

# TELESCOPE
TELESCOPE_ENABLED=true
TELESCOPE_DOMAIN=
TELESCOPE_PATH=telescope
TELESCOPE_DRIVER=database
TELESCOPE_QUEUE_CONNECTION=
TELESCOPE_QUEUE=
TELESCOPE_QUEUE_DELAY=10

# VITE
VITE_APP_NAME="${APP_NAME}"


# OPTIONAL DRIVERS / FULL CONFIG COVERAGE
DB_SOCKET=
DB_ENCRYPT=false
MYSQL_ATTR_SSL_CA=
REDIS_CLUSTER=redis
REDIS_PREFIX=
REDIS_PERSISTENT=false
SESSION_COOKIE=
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=
BEANSTALKD_QUEUE_HOST=localhost
BEANSTALKD_QUEUE=default
BEANSTALKD_QUEUE_RETRY_AFTER=90
SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
SQS_QUEUE=default
SQS_SUFFIX=
PAPERTRAIL_URL=
PAPERTRAIL_PORT=
LOG_PAPERTRAIL_HANDLER=Monolog\Handler\SyslogUdpHandler
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=
TELESCOPE_BATCH_WATCHER=true
TELESCOPE_CACHE_WATCHER=true
TELESCOPE_CLIENT_REQUEST_WATCHER=true
TELESCOPE_COMMAND_WATCHER=true
TELESCOPE_DUMP_WATCHER=true
TELESCOPE_DUMP_WATCHER_ALWAYS=false
TELESCOPE_EVENT_WATCHER=true
TELESCOPE_EXCEPTION_WATCHER=true
TELESCOPE_GATE_WATCHER=true
TELESCOPE_JOB_WATCHER=true
TELESCOPE_LOG_WATCHER=true
TELESCOPE_MAIL_WATCHER=true
TELESCOPE_MODEL_WATCHER=true
TELESCOPE_NOTIFICATION_WATCHER=true
TELESCOPE_QUERY_WATCHER=true
TELESCOPE_REDIS_WATCHER=true
TELESCOPE_REQUEST_WATCHER=true
TELESCOPE_RESPONSE_SIZE_LIMIT=64
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_VIEW_WATCHER=true
