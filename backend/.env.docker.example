# Docker-safe Laravel example. Copy to a real secret store or override in compose for production.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://said-diplom.ru
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/oauth/yandex/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/oauth/github/callback
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=diplom
DB_USERNAME=diplom
DB_PASSWORD=diplom
DB_SSLMODE=prefer
DB_FOREIGN_KEYS=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

AUTH_GUARD=api
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_BROKER=users
# Required for auth. Generate locally and inject as a secret/env value:
# docker compose exec backend php artisan jwt:secret --show
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb
REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=local-app
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY="${OPENROUTER_API_KEY}"
AI_BASE_URL="${OPENROUTER_BASE_URL}"
AI_VECTOR_DRIVER=pgvector
AI_EMBEDDING_DIMENSIONS=2048
AI_INDEX_QUEUE=ai-index
AI_AUTO_ANSWER_QUESTIONS=false

CODE_RUNNER_TIME_LIMIT_MS=1500
CODE_RUNNER_MEMORY_LIMIT_MB=128
PLAYGROUND_MAX_CODE_CHARS=30000
PLAYGROUND_MAX_STDIN_CHARS=8000
PLAYGROUND_MAX_OUTPUT_CHARS=20000
CHAT_MAX_FILES=5
CHAT_MAX_FILE_KB=10240
USER_FILE_MAX_FILE_KB=20480
AVATAR_MAX_FILE_KB=2048

TELESCOPE_ENABLED=false

EMAIL_VERIFICATION_EXPIRE_MINUTES=10
