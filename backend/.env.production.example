APP_NAME="Вектор"
APP_ENV=production
APP_KEY=base64:GENERATE_ME
APP_DEBUG=false
APP_URL=https://said-diplom.ru
FRONTEND_URL=https://said-diplom.ru
GOOGLE_REDIRECT_URI=https://said-diplom.ru/api/auth/oauth/google/callback
YANDEX_REDIRECT_URI=https://said-diplom.ru/api/auth/oauth/yandex/callback
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_REDIRECT_URI=https://said-diplom.ru/api/auth/oauth/github/callback
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vector
DB_USERNAME=vector
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSLMODE=prefer
DB_FOREIGN_KEYS=true

POSTGRES_DB=vector
POSTGRES_USER=vector
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

AUTH_GUARD=api
AUTH_MODEL=App\Models\User
AUTH_PASSWORD_BROKER=users
JWT_SECRET=GENERATE_ME
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=10

FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb
REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_APP_ID=local-app
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=https://said-diplom.ru,https://www.said-diplom.ru

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_VECTOR_DRIVER=pgvector
AI_EMBEDDING_DIMENSIONS=2048
AI_INDEX_QUEUE=ai-index
AI_AUTO_ANSWER_QUESTIONS=false

CODE_RUNNER_TIME_LIMIT_MS=1500
CODE_RUNNER_MEMORY_LIMIT_MB=128
PLAYGROUND_MAX_CODE_CHARS=30000
PLAYGROUND_MAX_STDIN_CHARS=8000
PLAYGROUND_MAX_OUTPUT_CHARS=20000
CHAT_MAX_FILES=5
CHAT_MAX_FILE_KB=10240
USER_FILE_MAX_FILE_KB=20480
AVATAR_MAX_FILE_KB=2048

TELESCOPE_ENABLED=false
