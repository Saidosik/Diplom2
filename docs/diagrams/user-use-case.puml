@startuml
left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam rectangle {
  BorderColor #0F172A
  BackgroundColor #FFFFFF
}
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam note {
  BackgroundColor #FEF3C7
  BorderColor #D97706
}

title UML Use Case Diagram — пользователь платформы «Вектор»

actor "Пользователь" as User

rectangle "Платформа «Вектор»" as System {
  usecase "Войти в систему" as UC_Login

  usecase "Просмотреть ленту\nи материалы" as UC_Browse
  usecase "Искать материалы\nи участников" as UC_Search

  usecase "Управлять профилем\nи файлами" as UC_ProfileFiles
  usecase "Создавать публикации,\nвопросы и ответы" as UC_CreateContent
  usecase "Взаимодействовать\nс контентом" as UC_Interact
  usecase "Общаться\nс участниками" as UC_Communicate
  usecase "Работать с AI-\nпомощником" as UC_Assistant
  usecase "Запускать код\nв песочнице" as UC_Playground

  usecase "Выйти из системы" as UC_Logout

  note right of UC_ProfileFiles
    Доступно после авторизации
  end note
}

User -- UC_Login
User -- UC_Browse
User -- UC_Search
User -- UC_ProfileFiles
User -- UC_CreateContent
User -- UC_Interact
User -- UC_Communicate
User -- UC_Assistant
User -- UC_Playground
User -- UC_Logout

@enduml
