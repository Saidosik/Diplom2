@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
}
skinparam rectangle {
  BorderColor #0F172A
  BackgroundColor #FFFFFF
}

title UML Use Case Diagram — «Вектор»
caption Легенда: <<include>> — обязательный общий сценарий; <<extend>> — условное или альтернативное поведение.

actor "Посетитель" as Visitor
actor "Зарегистрированный\nпользователь" as Registered
actor "Сотрудник" as Staff
actor "Модератор" as Moderator
actor "Администратор" as Admin
actor "OAuth-провайдер\n(Google/Yandex)" as OAuth
actor "Почтовый сервис" as Mail
actor "AI-провайдер" as AIProvider
actor "Изолированная среда\nвыполнения кода" as CodeEnv

Registered --|> Visitor
Staff --|> Registered
Moderator --|> Staff
Admin --|> Staff

rectangle "Платформа «Вектор»" as System {
  usecase "Просматривать ленту\nи материалы" as UC_Browse
  usecase "Искать материалы\nи участников" as UC_Search
  usecase "Просматривать\nпубличный профиль" as UC_PublicProfile
  usecase "Зарегистрироваться\nи подтвердить email" as UC_Register
  usecase "Войти в систему" as UC_Login
  usecase "Войти через OAuth" as UC_OAuthLogin
  usecase "Восстановить пароль" as UC_ResetPassword
  usecase "Отправить email-\nуведомление" as UC_SendEmail

  usecase "Управлять профилем\nи файлами" as UC_ProfileFiles
  usecase "Создавать и вести\nпубликации" as UC_Publications
  usecase "Задавать вопросы\nи отвечать" as UC_QA
  usecase "Взаимодействовать\nс контентом" as UC_Interactions
  usecase "Настраивать интересы\nи уведомления" as UC_Preferences
  usecase "Общаться с участниками" as UC_Social
  usecase "Работать с AI-\nпомощником" as UC_AI
  usecase "Запускать код\nв песочнице" as UC_Playground

  usecase "Модерировать жалобы" as UC_ModerateReports
  usecase "Модерировать контент\nи чаты" as UC_ModerateContent
  usecase "Управлять пользователями\nи тегами" as UC_ManageUsersTags
  usecase "Управлять AI-индексом,\nлогами и правовыми страницами" as UC_SystemAdmin
}

Visitor --> UC_Browse
Visitor --> UC_Search
Visitor --> UC_PublicProfile
Visitor --> UC_Register
Visitor --> UC_Login
Visitor --> UC_ResetPassword

Registered --> UC_ProfileFiles
Registered --> UC_Publications
Registered --> UC_QA
Registered --> UC_Interactions
Registered --> UC_Preferences
Registered --> UC_Social
Registered --> UC_AI
Registered --> UC_Playground

Staff --> UC_ModerateReports
Staff --> UC_ModerateContent
Staff --> UC_ManageUsersTags
Admin --> UC_SystemAdmin

OAuth --> UC_OAuthLogin
Mail --> UC_SendEmail
AIProvider --> UC_AI
CodeEnv --> UC_Playground

UC_OAuthLogin ..> UC_Login : <<extend>>
UC_Register ..> UC_SendEmail : <<include>>
UC_ResetPassword ..> UC_SendEmail : <<include>>
@enduml
